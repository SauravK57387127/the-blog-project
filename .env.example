# =========================
# App
# =========================

NODE_ENV=development
PORT=7000
WORKER_PORT=4001

# =========================
# MongoDB
# =========================

DB_NAME=your_database_name
MONGO_URI=mongodb://localhost:27017

# =========================
# PostgreSQL
# =========================

POSTGRES_DATABASE_URL=postgresql://postgres:password@localhost:5432/db

# =========================
# Redis
# =========================

REDIS_URL=redis://localhost:6379

# =========================
# Feature Flags
# =========================

ENABLE_MONGO=true
ENABLE_PRISMA=true
ENABLE_REDIS=true
ENABLE_CACHE=false

# =========================
# Admin Auth
# =========================

ADMIN_JWT_SECRET=your_secret
ADMIN_ACCESS_TOKEN_EXPIRY=15m

ADMIN_JWT_REFRESH_SECRET=your_refresh_secret
ADMIN_REFRESH_TOKEN_EXPIRY=7d

# =========================
# Rate Limiting
# =========================

RATE_LIMIT_ADMIN_LOGIN=10
RATE_LIMIT_ADMIN=100
RATE_LIMIT_PUBLIC=300
RATE_LIMIT_USER=200

# =========================
# Clerk
# =========================

CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# =========================
# Analytics
# =========================

NEXT_PUBLIC_GA_MEASUREMENT_ID=

# =========================
# Cloudinary
# =========================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =========================
# Sentry
# =========================

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# =========================
# Docker / Postgres
# =========================

POSTGRES_PASSWORD=password

# =========================
# Frontend
# =========================

NEXT_PUBLIC_API_URL=http://localhost:7000

# =========================
# CORS
# =========================

ALLOWED_ORIGINS=http://localhost:3000
