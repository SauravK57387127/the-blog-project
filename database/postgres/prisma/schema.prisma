model Event {
  id        Int      @id @default(autoincrement())
  name      String?
  userId    String?   // null = anonymous
  sessionId String?
  properties Json
  createdAt DateTime @default(now())
}



// ==================== ADMIN AUTHENTICATION ====================

model Admin {
  id              Int       @id @default(autoincrement())
  
  // Login credentials
  username        String    @unique
  // Why username not email? Harder for attackers to guess (emails are often public)
  
  passwordHash    String
  // NEVER store plain password! This is bcrypt hash with 12 rounds
  
  // Security metadata
  lastLoginAt     DateTime?
  lastLoginIP     String?
  // Track when/where admin last logged in (detect suspicious activity)
  
  failedAttempts  Int       @default(0)
  // Count failed login attempts (for account lockout)
  
  lockedUntil     DateTime?
  // If account is locked (after 5 failed attempts), unlock after this time
  
  // Permissions (we'll keep it simple for now)
  role            String    @default("admin")  // "super_admin" or "admin"
  // super_admin = full access, admin = limited access
  
  // Relationships
  refreshTokens   AdminRefreshToken[]  // One admin has many refresh tokens (multiple devices)
  auditLogs       AuditLog[]           // Track all actions this admin performed
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Indexes for faster queries
  @@index([username])
}

