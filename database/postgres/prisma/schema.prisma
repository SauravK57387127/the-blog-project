model AdminRefreshToken {
  id            Int       @id @default(autoincrement())
  adminId       Int
  admin         Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  tokenHash     String    @unique
  deviceId      String    // ← Add this
  deviceInfo    String?
  ipAddress     String?
  
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt  // ← Add this for tracking token rotation
  
  @@index([adminId])
  @@index([tokenHash])
  @@index([deviceId])  // ← Add this
  @@index([adminId, deviceId])  // ← Composite index for faster lookup
}


// ==================== AUDIT LOGGING ====================

model AuditLog {
  id            Int       @id @default(autoincrement())
  
  adminId       Int?
  admin         Admin?    @relation(fields: [adminId], references: [id])
  // Nullable because failed login attempts won't have valid adminId
  
  action        String
  // Examples: "LOGIN", "LOGOUT", "CREATE_BLOG", "DELETE_USER", "UPDATE_SUBSCRIBER"
  
  resource      String?
  // What was acted upon? "blog", "user", "subscriber"
  
  resourceId    String?
  // Which specific item? MongoDB ObjectId or Prisma ID
  
  // HTTP Request details
  method        String?   // "GET", "POST", "DELETE"
  endpoint      String?   // "/api/admin/blogs/123"
  
  // Security context
  ipAddress     String?
  userAgent     String?   // Browser/device info
  
  // Result
  statusCode    Int?      // 200 = success, 401 = unauthorized, etc.
  errorMessage  String?   // If request failed, what was the error?
  
  metadata      Json?
  // Flexible field for additional context
  // Example: { "oldTitle": "Hello", "newTitle": "World", "fieldsChanged": ["title"] }
  
  createdAt     DateTime  @default(now())
  
  // Indexes for admin dashboard queries
  @@index([adminId, createdAt])  // "Show me all actions by admin #5 today"
  @@index([action])              // "Show me all DELETE_BLOG actions"
  @@index([createdAt])           // "Show me recent activity"
  @@index([ipAddress])           // "Show me all actions from this IP"
}
